--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-macos, x86_64h-macos,
                   arm64-macos, arm64e-macos ]
install-name:    'libtapdecoder.dylib'
exports:
  - targets:         [ x86_64-macos, x86_64h-macos,
                       arm64-macos, arm64e-macos ]
    symbols:         [ _tapdec_init2, _tapdec_exit,
                       _tapdec_set_pulse, _tapdec_get_buffer,
                       _tapdec_enable_halfwaves ]
...
